// Genesis for solv_1g_money. GENESIS IS THE EQUILIBRIUM — see game_data.ron for
// the derivation of every number. Each entry is the unique value a rest
// condition requires, not a plausible starting point.
//
// The two cash balances are the whole point of this tape and are not free:
//   pop  65 = b_cash * basket_cost / s = 6.5 * (2.0 * 10 * 0.5) / 1, so
//            sigma_c = (65 - 65)/65 = 0 EXACTLY and the tier does not move.
//   firm 75 = (b_cash/s + s) * outlay = 7.5 * 10, so Rule 3's overflow is 0.
//   M = 140, and p_grain = M/(N*r*(2*b_cash+1)) = 140/280 = 0.5 closes the loop.
(
    tick: 0,
    prices: { "grain": 0.5, "gbp": 1.0, "labour": 1.0 },
    buildings: [
        (
            id: (0), region: (0), recipe: "grow_grain",
            recipe_size: 25.0, chosen_size: 20.0, efficiency: 1.0,
            inventory: { "gbp": 75.0, "grain": 60.0 },
        ),
    ],
    pop_groups: [
        // wealth 0.5 is the interior tier: interpolated_qty(0.5) = 1 + 0.5*(3-1)
        // = 2 = r, which is the only basket a one-factor economy can sustain.
        // It sits strictly between the two registered tiers, so the wealth rule
        // is free to move in both directions and a defect cannot hide at a clamp.
        //
        // Subsistence baskets per unit of labour: the pop's outside option.
        // Derived from technology by tools/derive_parity.py, never from prices,
        // because RealWage is a scored series (R6):
        //   tier-0 basket embodies 1.0 grain * 0.5 labour/grain = 0.5 labour
        //   market rate 1/0.5 = 2.0 baskets per labour
        //   parity = HOME_PENALTY * market rate = 0.5 * 2.0 = 1.0
        (
            id: (0), region: (0), size: 10.0, wealth: 0.5,
            inventory: { "gbp": 65.0 },
            savings_target: 0.9,
            labour_good: Some("labour"),
            parity: Some(1.0),
        ),
    ],
    extra_recipe_instances: [
        ( recipe: "dividend", building: (0), output_pop: (0), recipe_size: 1000.0 ),
    ],
)
