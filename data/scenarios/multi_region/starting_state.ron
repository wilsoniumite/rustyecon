// Buildings 0-2: grain mills (one per region, recipe_size=35 = ~2.5x average regional demand).
// Buildings 3-8: flour_transport channel operators, one per directed channel edge.
//   Channel op region is set to the source region of the channel.
//
// Pop groups at wealth 4 (need 1.4 flour/pop/tick).
//   Manchester: 10 pops, local wheat 16/tick → surplus 2/tick
//   Leeds:      11 pops, local wheat 12/tick → deficit 3.4/tick
//   Birmingham:  9 pops, local wheat 14/tick → surplus 1.4/tick
//
// Pop starting GBP is set to 4*basket_cost - UBI so that savings_target=0.75
// gives excess_ratio≈0 at tick 0 (wealth stable at tier 4 from the first tick).
// Mills start with one tick of local flour demand so pops can buy on tick 0
// before production has fired.
//
// Magic producers post wheat to each regional node.
// Channel states: one entry per channel (index matches ChannelId), occupant = channel op building.
(
    tick: 0,
    buildings: [
        // Mills
        (id: (0), region: (0), recipe: "grain_mill",      recipe_size: 35.0, chosen_size: 0.0, efficiency: 1.0, inventory: {"GBP": 50.0, "flour": 14.0}, transfer_target: None, owners: [], channel: None),
        (id: (1), region: (1), recipe: "grain_mill",      recipe_size: 35.0, chosen_size: 0.0, efficiency: 1.0, inventory: {"GBP": 50.0, "flour": 16.0}, transfer_target: None, owners: [], channel: None),
        (id: (2), region: (2), recipe: "grain_mill",      recipe_size: 35.0, chosen_size: 0.0, efficiency: 1.0, inventory: {"GBP": 50.0, "flour": 13.0}, transfer_target: None, owners: [], channel: None),
        // Channel operators
        (id: (3), region: (0), recipe: "flour_transport", recipe_size: 10.0, chosen_size: 0.0, efficiency: 1.0, inventory: {"GBP": 50.0}, transfer_target: None, owners: [], channel: Some((0))),
        (id: (4), region: (1), recipe: "flour_transport", recipe_size: 10.0, chosen_size: 0.0, efficiency: 1.0, inventory: {"GBP": 50.0}, transfer_target: None, owners: [], channel: Some((1))),
        (id: (5), region: (0), recipe: "flour_transport", recipe_size: 10.0, chosen_size: 0.0, efficiency: 1.0, inventory: {"GBP": 50.0}, transfer_target: None, owners: [], channel: Some((2))),
        (id: (6), region: (2), recipe: "flour_transport", recipe_size: 10.0, chosen_size: 0.0, efficiency: 1.0, inventory: {"GBP": 50.0}, transfer_target: None, owners: [], channel: Some((3))),
        (id: (7), region: (1), recipe: "flour_transport", recipe_size: 10.0, chosen_size: 0.0, efficiency: 1.0, inventory: {"GBP": 50.0}, transfer_target: None, owners: [], channel: Some((4))),
        (id: (8), region: (2), recipe: "flour_transport", recipe_size: 10.0, chosen_size: 0.0, efficiency: 1.0, inventory: {"GBP": 50.0}, transfer_target: None, owners: [], channel: Some((5))),
    ],
    pop_groups: [
        (id: (0), region: (0), size: 10.0, wealth: 0.0, inventory: {"GBP": 41.0}, savings_target: 0.75),
        (id: (1), region: (1), size: 11.0, wealth: 0.0, inventory: {"GBP": 45.0}, savings_target: 0.75),
        (id: (2), region: (2), size:  9.0, wealth: 0.0, inventory: {"GBP": 37.0}, savings_target: 0.75),
    ],
    channels: [
        (regulatory_factor: 1.0, occupant: Some((3))),
        (regulatory_factor: 1.0, occupant: Some((4))),
        (regulatory_factor: 1.0, occupant: Some((5))),
        (regulatory_factor: 1.0, occupant: Some((6))),
        (regulatory_factor: 1.0, occupant: Some((7))),
        (regulatory_factor: 1.0, occupant: Some((8))),
    ],
    magic_producers: [
        (id: (0), node: (0), good: "wheat", qty_per_tick: 16.0),
        (id: (1), node: (1), good: "wheat", qty_per_tick: 12.0),
        (id: (2), node: (2), good: "wheat", qty_per_tick: 14.0),
