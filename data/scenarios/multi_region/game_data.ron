// Three-region scenario: Manchester, Leeds, Birmingham.
// Each region has a magic wheat producer and an oversized grain mill.
// Six flour_transport channel operator buildings form a full mesh between regions.
// Total wheat (42/tick) exactly covers all pop demand at wealth tier 4 (30 pops × 1.4).
// Local surpluses: Manchester +2, Birmingham +1.4. Local deficit: Leeds -3.4.
(
    goods: [
        (name: "wheat", alpha: 0.2, shelf_life: Indefinite, movement_type: Physical, divisible: true, storage_cost_per_tick: 0.0),
        (name: "flour", alpha: 0.2, shelf_life: Indefinite, movement_type: Physical, divisible: true, storage_cost_per_tick: 0.0),
        (name: "GBP",   alpha: 0.0, shelf_life: Indefinite, movement_type: Financial, divisible: true, storage_cost_per_tick: 0.0),
    ],
    recipes: [
        (
            name: "wheat_farm",
            inputs: [],
            outputs: [(good: "wheat", qty_per_unit: 1.0)],
            reversible: false,
        ),
        (
            name: "grain_mill",
            inputs: [(good: "wheat", qty_per_unit: 1.0, scaling: Variable)],
            outputs: [(good: "flour", qty_per_unit: 1.0)],
            reversible: false,
        ),
        (
            name: "flour_transport",
            inputs: [
                (good: "flour", qty_per_unit: 1.0, scaling: Variable),
                (good: "GBP",   qty_per_unit: 0.1, scaling: Variable),
            ],
            outputs: [(good: "flour", qty_per_unit: 1.0)],
            reversible: false,
        ),
    ],
    need_categories: [
        (
            name: "staple_food",
            entries: [
                (good: "flour", weight: 1.0, max_allocation: 1.0, min_allocation: 0.0),
            ],
        ),
    ],
    wealth_levels: [
        (tier: 0,  needs: {"staple_food": 1.0}),
        (tier: 1,  needs: {"staple_food": 1.1}),
        (tier: 2,  needs: {"staple_food": 1.2}),
        (tier: 3,  needs: {"staple_food": 1.3}),
        (tier: 4,  needs: {"staple_food": 1.4}),
        (tier: 5,  needs: {"staple_food": 1.6}),
        (tier: 6,  needs: {"staple_food": 1.8}),
        (tier: 7,  needs: {"staple_food": 2.0}),
        (tier: 8,  needs: {"staple_food": 2.4}),
        (tier: 9,  needs: {"staple_food": 2.8}),
        (tier: 10, needs: {"staple_food": 3.6}),
    ],
    market_nodes: [
        (id: MarketNodeId(0), tier: Regional, region: Some(RegionId(0))),
        (id: MarketNodeId(1), tier: Regional, region: Some(RegionId(1))),
        (id: MarketNodeId(2), tier: Regional, region: Some(RegionId(2))),
    ],
    channels: [
        (id: ChannelId(0), from: MarketNodeId(0), to: MarketNodeId(1), channel_type: Trade),
        (id: ChannelId(1), from: MarketNodeId(1), to: MarketNodeId(0), channel_type: Trade),
        (id: ChannelId(2), from: MarketNodeId(0), to: MarketNodeId(2), channel_type: Trade),
        (id: ChannelId(3), from: MarketNodeId(2), to: MarketNodeId(0), channel_type: Trade),
        (id: ChannelId(4), from: MarketNodeId(1), to: MarketNodeId(2), channel_type: Trade),
        (id: ChannelId(5), from: MarketNodeId(2), to: MarketNodeId(1), channel_type: Trade),
    ],
    currency_good: Some("GBP"),
    regions: [
        (id: RegionId(0), name: "Manchester", market_node: MarketNodeId(0)),
        (id: RegionId(1), name: "Leeds",      market_node: MarketNodeId(1)),
        (id: RegionId(2), name: "Birmingham", market_node: MarketNodeId(2)),
    ],
)
