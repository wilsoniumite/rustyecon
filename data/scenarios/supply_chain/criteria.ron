// Stability criteria — dated, pre-registered (METHODOLOGY R6, engine.md).
//
// Variant of the ported 07-suite taxonomy for a scenario with NO LABOUR MARKET.
// RealWage is price(labour)/price(staple), and this scenario defines no labour
// good, so that metric is not merely missing — it is inapplicable. It is dropped
// from UNSTABLE and SWINGING here rather than left to evaluate as NaN.
//
// This is the registered-convention half of engine.md's NaN rule: a value that
// cannot exist by construction is declared absent in the criteria, while a value
// that should exist and cannot be computed still fails closed. Silencing the
// latter by widening this exemption would defeat the policy.
//
// CHANGING A THRESHOLD AFTER SEEING RESULTS REQUIRES A NEW DATED FILE.
//
// Window is the ported one — ticks 150..1000, the span the thresholds were
// calibrated against.
(
    version: 1,
    date: "2026-07-20",
    transient: 150,
    analysis_end: 1000,
    staple_good: "flour",
    labour_good: "",  // none in this scenario
    nan_policy: FailClosed,
    classes: [
        // A region with no transaction velocity is not an economy. Checked first
        // and short-circuits: once dead, nothing else about it is meaningful.
        (
            name: "DEAD",
            fatal: true,
            metrics: [Velocity],
            rule: FracBelow(thresh: 0.003, frac: 0.80),
            window: Analysis,
            short_circuit: true,
        ),
        (
            name: "DEAD_EMPLOYMENT",
            fatal: true,
            metrics: [Employment],
            rule: FracBelow(thresh: 0.05, frac: 0.80),
            window: Analysis,
        ),
        // Short-term oscillation: the rolling coefficient of variation.
        (
            name: "UNSTABLE",
            fatal: true,
            metrics: [Velocity, Employment],
            rule: RollingCv(window: 10, max_cv: 0.12),
            window: Analysis,
        ),
        // Not settling: second-half variance still close to the first half's.
        (
            name: "SWINGING",
            fatal: true,
            metrics: [Velocity],
            rule: Damping(max_ratio: 0.72),
            window: Halves,
        ),
        // Currency pooling in buildings and still trending that way.
        (
            name: "CURRENCY_DRAIN",
            fatal: true,
            metrics: [Concentration],
            rule: MeanAndSlope(mean_min: 0.82, slope_min: 0.0),
            window: Analysis,
        ),
        (
            name: "POP_DESTITUTION",
            fatal: true,
            metrics: [RealIncome],
            rule: FracBelow(thresh: 0.8, frac: 0.50),
            window: Analysis,
        ),
        // Warning only: an idle plant is a symptom, not a failed region.
        (
            name: "DEAD_BUILDING",
            fatal: false,
            metrics: [BldUtil],
            rule: FracBelow(thresh: 0.05, frac: 0.60),
            window: PostTransient,
        ),
    ],
)
