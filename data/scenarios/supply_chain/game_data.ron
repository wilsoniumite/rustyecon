// Supply chain: wheat (MagicProducer) → grain mill → flour → pops.
// Three goods: wheat, flour, GBP (currency). Shock at tick 49: wheat supply halved.
(
    // ── Desk kernel (kernel.md, "Parameters"; METHODOLOGY R2) ─────────────
    // Registered here rather than in code so the phase map (PLAN Phase 5) can
    // sweep them. Defaults are kernel.md's table; epsilon, phi and fill_alpha
    // are the three the table omits and are documented on KernelParams.
    kernel: (
        s: 4,
        eta_up: 0.04,
        eta_dn: 0.05,
        dead: 0.05,
        b_out: 2.0,
        b_cash: 6.5,
        beta: 1.0,
        epsilon: 0.01,
        phi: 0.6180339887498949,
        fill_alpha: 0.25,
        // Which Rule 1 the desks post under. `inelastic` is the rule
        // shipped through Phase 4 (posted supply has price elasticity
        // exactly zero); `reservation` divides the band by the desk's
        // own markup, so b_out becomes the supply curve's slope.
        // Registered here, swept with --supply-rule.
        supply_rule: inelastic,
    ),
    goods: [
        (name: "wheat", alpha: 0.5, shelf_life: Indefinite, movement_type: Physical, divisible: true, storage_cost_per_tick: 0.0),
        (name: "flour", alpha: 0.5, shelf_life: Indefinite, movement_type: Physical, divisible: true, storage_cost_per_tick: 0.0),
        (name: "GBP",   alpha: 0.0, shelf_life: Indefinite, movement_type: Financial, divisible: true, storage_cost_per_tick: 0.0),
    ],
    recipes: [
        (
            name: "wheat_farm",
            inputs: [],
            outputs: [(good: "wheat", qty_per_unit: 1.0)],
            reversible: false,
        ),
        (
            name: "grain_mill",
            inputs: [(good: "wheat", qty_per_unit: 1.0, scaling: Variable)],
            outputs: [(good: "flour", qty_per_unit: 1.0)],
            reversible: false,
        ),
    ],
    need_categories: [
        (
            name: "staple_food",
            entries: [
                (good: "flour", weight: 1.0, max_allocation: 1.0, min_allocation: 0.0),
            ],
        ),
    ],
    wealth_levels: [
        // tier 0: subsistence — 1 flour/person/tick
        // At UBI=10 GBP and flour price ~1.0, total spend ≈ 10 GBP = UBI → equilibrium.
        (tier: 0, needs: {"staple_food": 1.0}),
        // tier 1: modest — 1.5 flour/person/tick. Requires income > 15 GBP to sustain.
        (tier: 1, needs: {"staple_food": 1.1}),
        (tier: 2, needs: {"staple_food": 1.2}),
        (tier: 3, needs: {"staple_food": 1.3}),
        (tier: 4, needs: {"staple_food": 1.4}),
        (tier: 5, needs: {"staple_food": 1.6}),
        (tier: 6, needs: {"staple_food": 1.8}),
        (tier: 7, needs: {"staple_food": 2.0}),
        (tier: 8, needs: {"staple_food": 2.4}),
        (tier: 9, needs: {"staple_food": 2.8}),
        (tier: 10, needs: {"staple_food": 3.6}),
    ],
    market_nodes: [
        (id: MarketNodeId(0), tier: Regional, region: Some(RegionId(0)), currency_good: Some(GoodId(2))),
    ],
    channels: [],
    regions: [
        (id: RegionId(0), name: "Manchester", market_node: MarketNodeId(0)),
    ],
)
