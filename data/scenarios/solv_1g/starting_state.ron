// Genesis for solv_1g. GENESIS IS THE EQUILIBRIUM — see game_data.ron for the
// derivation of every number below. Nothing here is a "reasonable starting
// point"; each entry is the unique value the rest condition requires, and the
// mode-A test asserts the state never moves off it.
//
// Traced by hand across one tick before it was ever run (docs/design/
// solvable-scenarios.md §6): posted grain 60 - 2*20*1 = 20 == demand 20;
// imbalance 0 exactly; sigma = margin/reference = 0, inside the dead band;
// fill EMA 0.25*1 + 0.75*1 = 1, so no SetDeskFill; pi already clamped at 1, so
// no SetPopParticipation; overflow 75 - 65 - 10 = 0, below the 1e-12 gate;
// price_ema already equals price. The only genesis transient is the legacy
// AdjustInstanceBalance settling cs.balance to -10 on tick 0 — a field the
// kernel never reads.
(
    tick: 0,
    // The equilibrium price vector. p_grain = a*p_labour = 0.5*1.0.
    prices: { "grain": 0.5, "gbp": 1.0, "labour": 1.0 },
    buildings: [
        // grain 60 = (1 + b_out)*chosen_size, so Rule 1 posts exactly 20, which
        // is exactly the pop's demand.
        // gbp 75 = (b_cash/s + s)*outlay = 7.5*10, so Rule 3's overflow is
        // exactly 0 and the firm neither pools cash nor pays a dividend.
        // recipe_size 25 > chosen_size 20 DELIBERATELY: scale sits strictly
        // inside its clamp and is free to move in both directions, so a defect
        // cannot be masked by a bound. BldUtil is therefore 0.8, not 1.0.
        (
            id: (0), region: (0), recipe: "grow_grain",
            recipe_size: 25.0, chosen_size: 20.0, efficiency: 1.0,
            inventory: { "gbp": 75.0, "grain": 60.0 },
        ),
    ],
    pop_groups: [
        // Subsistence baskets per unit of labour: the pop's outside option.
        // Derived from technology by tools/derive_parity.py, never from prices,
        // because RealWage is a scored series (R6):
        //   basket embodies 2.0 grain * 0.5 labour/grain = 1.0 labour
        //   market rate 1/1.0 = 1.0 baskets per labour
        //   parity = HOME_PENALTY * market rate = 0.5
        // Confirmed by running the tool against this finished tape.
        //
        // savings_target 0.9 is inert under the kernel; it keeps the LEGACY
        // arm's pop wealth PD controller resting rather than ramping.
        (
            id: (0), region: (0), size: 10.0, wealth: 0.0,
            inventory: { "gbp": 30.0 },
            savings_target: 0.9,
            labour_good: Some("labour"),
            parity: Some(0.5),
        ),
    ],
    // The claim-holder pointer. Under the kernel this instance's chosen_size is
    // forced to 0 and it exists only to tell Rule 3 where a firm's overflow
    // goes; under legacy it is the dividend desk.
    extra_recipe_instances: [
        ( recipe: "dividend", building: (0), output_pop: (0), recipe_size: 1000.0 ),
    ],
)
