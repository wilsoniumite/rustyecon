// Genesis for the 225-year tracer (see game_data.ron for the design rationale).
//
// The labour market is set to clear exactly: the recipe draws
// qty_per_unit * recipe_size = 1.0 * 1.8 units of labour per tick, against a
// pop supplying size * LABOUR_RATE = 2.0. Both fill rates are then computed
// from ratios that are exact in binary floating point, so employment sits at a
// genuine fixed point rather than jittering.
//
// grain: 1.386 is the producer's stock fixed point under the capacity
// controller (S* = 1.386 * D). Starting there rather than at zero skips a
// transient the scoring window would otherwise have to absorb.
(
    tick: 0,
    prices: { "grain": 2.0, "gbp": 1.0, "labour": 1.0 },
    buildings: [
        ( id: (0), region: (0), recipe: "grow_grain", recipe_size: 1.8, chosen_size: 1.0, efficiency: 1.0,
          inventory: { "gbp": 60.0, "grain": 1.386 } ),
        ( id: (1), region: (1), recipe: "grow_grain", recipe_size: 1.8, chosen_size: 1.0, efficiency: 1.0,
          inventory: { "gbp": 60.0, "grain": 1.386 } ),
    ],
    pop_groups: [
        ( id: (0), region: (0), size: 2.0, wealth: 0.0, inventory: { "gbp": 100.0 }, savings_target: 0.9, labour_good: Some("labour") ),
        ( id: (1), region: (1), size: 2.0, wealth: 0.0, inventory: { "gbp": 100.0 }, savings_target: 0.9, labour_good: Some("labour") ),
    ],
    // The currency return path. One per region, paying its own region's pop.
    extra_recipe_instances: [
        ( recipe: "dividend", building: (0), output_pop: (0), recipe_size: 1000.0 ),
        ( recipe: "dividend", building: (1), output_pop: (1), recipe_size: 1000.0 ),
    ],
)
